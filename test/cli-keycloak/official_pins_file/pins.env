# One pins file can hold every feature's pins; cli-keycloak reads only its
# own CLI_KEYCLOAK_* keys. The export form and a quoted value are accepted.
CLI_OTHER_VERSION=9.9.9
export CLI_KEYCLOAK_FLAVOR="official"

# renovate: datasource=github-releases depName=keycloak/keycloak
CLI_KEYCLOAK_VERSION=26.7.5
CLI_KEYCLOAK_SHA256=87d680d13cf4600d232ca0433a2553c57ebf03e56f7718fc0d03a1a8705497c8 # keycloak-<v>.tar.gz
